[node name="LabelInstruction" type="Label" parent="UIManager" unique_id=1465220750]
offset_left = 23.0
offset_top = 15.0
offset_right = 900.0
offset_bottom = 480.0
theme_override_font_sizes/font_size = 16
text = "╔════════════════════════════════════════════════════════════════════════════════════╗
║                          HUEVO O NADA — SIMULADOR DE GRANJA                          ║
║                                                                                        ║
║  El abuelo don Ernesto murió dejándote su granja avícola en la vereda El Retiro.    ║
║  Lo que no sabías era que también te dejaba una deuda de $1.500.000 con el          ║
║  Banco Rural Andino.                                                                 ║
║                                                                                        ║
║  Tienes 30 DÍAS para hacer rentable la granja y saldar la deuda.                     ║
║  El banquero Rodrigo Urquijo ya tiene los papeles del embargo listos.                ║
║  Las gallinas te miran. Tú las miras. Alguien tiene que poner el primer huevo.       ║
║                                                                                        ║
╠════════════════════════════════════════════════════════════════════════════════════╣
║                                   CONTROLES DEL JUEGO                               ║
║                                                                                        ║
║  ➡️ FLECHAS         - Movimiento del jugador                                          ║
║  1️⃣ TECLA 1        - Comprar VACUNAS ($15.000) — Previene enfermedades               ║
║  2️⃣ TECLA 2        - Comprar MEDICAMENTOS ($8.000) — Cura gallinas enfermas          ║
║  3️⃣ TECLA 3        - AVANZAR AL SIGUIENTE DÍA                                         ║
║  4️⃣ TECLA 4        - Comprar GALLINAS ($75.000 por lote de 3)                        ║
║  🛑 ESPACIO        - INICIAR EL JUEGO                                                ║
║                                                                                        ║
╠════════════════════════════════════════════════════════════════════════════════════╣
║                              MECÁNICAS DEL JUEGO                                    ║
║                                                                                        ║
║  🐔 PRODUCCIÓN: Cada gallina sana tiene 80% de probabilidad de poner huevo/día     ║
║  🐭 PLAGAS: Los roedores roban huevos. Más gallinas = más roedores!                 ║
║  🦠 SALUD: Las enfermedades se propagan. Vacúnalas antes de que sea tarde            ║
║  📊 EDAD: Las gallinas envejecen. Invierte en mantener el plantel joven              ║
║  💰 ECONOMÍA: Vende huevos los días 5, 10, 15, 20, 25, 30. ¡Acumula $1.500.000!    ║
║                                                                                        ║
║                          ¡Presiona ESPACIO para comenzar!                            ║
╚════════════════════════════════════════════════════════════════════════════════════╝"
autowrap_mode = 2

